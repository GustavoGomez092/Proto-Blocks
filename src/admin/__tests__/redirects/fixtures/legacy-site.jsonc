// proto-redirects/legacy-site/redirects.jsonc
{
  "title": "Legacy site", // shown in the UI
  "enabled": true,
  "position": 10,
  "rules": [
    // About page moved in 2024.
    { "id": "r_00000001", "from": "/about-us", "to": "/about" },
    // Keep the old blog URLs alive.
    { "id": "r_00000002", "title": "Old blog", "from": "^/blog/(\\d+)/(.*)$", "regex": true, "to": "/news/$2" }, // regex
    { "id": "r_00000003", "from": "/promo", "to": "/sale", "code": 302, "query": "pass" },
    {
      // Spread over lines on purpose.
      "id": "r_00000004",
      "from": "/members",
      "when": { "type": "login" },
      "to": "/dashboard",
      "else": "/login"
    },
    { "from": "/gone-forever", "action": "error", "code": 410 }
    // End of rules.
  ]
}
