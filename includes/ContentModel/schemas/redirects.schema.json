{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proto-blocks/redirects.schema.json",
  "title": "Proto-Blocks redirects: group files (proto-redirects/<slug>/redirects.jsonc) and the settings file (proto-redirects/settings.jsonc)",
  "$defs": {
    "label": { "type": "string", "maxLength": 200, "pattern": "^[^<>]*$" },
    "url": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignoreCase": { "type": "boolean" },
        "ignoreTrailingSlash": { "type": "boolean" },
        "query": { "enum": ["exact", "exactOrder", "ignore", "pass"] }
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 1000 }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["login", "role", "referrer", "agent", "header", "cookie", "ip", "language", "server", "filter", "404"] },
        "value": {
          "anyOf": [
            { "type": "string", "maxLength": 500 },
            { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "regex": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^r_[a-f0-9]{8}$" },
        "title": { "$ref": "#/$defs/label" },
        "enabled": { "type": "boolean" },
        "from": { "$ref": "#/$defs/url" },
        "regex": { "type": "boolean" },
        "to": { "$ref": "#/$defs/url" },
        "else": { "$ref": "#/$defs/url" },
        "code": { "type": "integer", "minimum": 100, "maximum": 599 },
        "action": { "enum": ["url", "error", "pass", "nothing"] },
        "when": { "$ref": "#/$defs/when" },
        "query": { "enum": ["exact", "exactOrder", "ignore", "pass"] },
        "ignoreCase": { "type": "boolean" },
        "ignoreTrailingSlash": { "type": "boolean" },
        "log": { "type": "boolean" },
        "headers": { "$ref": "#/$defs/headers" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^<>]*$" },
        "enabled": { "type": "boolean" },
        "position": { "type": "integer", "minimum": -10000, "maximum": 10000 },
        "defaults": { "$ref": "#/$defs/flags" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "defaults": { "$ref": "#/$defs/flags" },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "redirects": { "type": "integer", "minimum": -1, "maximum": 90 },
            "notFound": { "type": "integer", "minimum": -1, "maximum": 90 },
            "ip": { "enum": ["none", "masked", "full"] },
            "headers": { "type": "boolean" },
            "external": { "type": "boolean" },
            "trustedProxies": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 49 } },
            "ipHeaders": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["CF-Connecting-IP", "X-Forwarded-For", "X-Real-IP", "Client-IP", "True-Client-IP"] }
            }
          }
        },
        "trackHits": { "type": "boolean" },
        "cache": { "enum": [-1, 0, 1, 24, 168] },
        "monitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_-]{1,20}$" } },
            "group": { "type": "string", "pattern": "^(?!settings$)[a-z][a-z0-9_-]{0,59}$" },
            "trash": { "type": "boolean" },
            "associated": { "type": "string", "maxLength": 100, "pattern": "^(|/[^\\s<>]*)$" }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "site": { "$ref": "#/$defs/headers" },
            "redirect": { "$ref": "#/$defs/headers" }
          }
        },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "https": { "type": "boolean" },
            "www": { "enum": ["", "www", "nowww"] },
            "aliases": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 253 } },
            "relocate": { "type": "string", "maxLength": 2000 }
          }
        },
        "coexist": { "type": "boolean" }
      }
    }
  }
}
